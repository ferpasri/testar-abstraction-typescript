{
    "name": "testar-abstraction",
    "version": "0.3.1",
    "description": "TypeScript implementation of the shared TESTAR abstraction language",
    "type": "module",
    "license": "BSD-3-Clause",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "docs",
        "README.md",
        "LICENSE",
        "TODO.md",
        "compatibility.json"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "vitest run",
        "prepare": "npm run build",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -p tsconfig.test.json",
        "check": "npm run typecheck && npm test",
        "prepare:conformance": "node tools/prepare-conformance.ts"
    },
    "dependencies": {
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/node": "26.6.5",
        "prettier": "3.9.10",
        "typescript": "7.0.2",
        "vitest": "5.0.5",
        "fflate": "0.8.3"
    },
    "engines": {
        "node": ">=24"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ferpasri/testar-abstraction-typescript.git"
    }
}
